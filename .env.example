# =====================================================
# endless-war — environment variables (template)
# Copy to `.env` and fill in. NEVER commit `.env`.
# =====================================================

# --- App ---
APP_ENV=development                    # development | staging | production
APP_NAME=endless-war
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Backend / FastAPI ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=endlesswar
POSTGRES_PASSWORD=devpass_change_me
POSTGRES_DB=endlesswar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://endlesswar:devpass_change_me@postgres:5432/endlesswar

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=endlesswar
MINIO_SECURE=false

# --- Steam OpenID (Phase 1, optional in dev — leave blank to use mock) ---
STEAM_API_KEY=
STEAM_REALM=http://localhost:8000
STEAM_RETURN_URL=http://localhost:8000/auth/steam/callback

# --- Email (Phase 1, optional in dev) ---
EMAIL_PROVIDER=resend                  # resend | postmark | smtp | console
EMAIL_FROM=noreply@endless-war.local
RESEND_API_KEY=

# --- Frontend (Next.js public env) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=endless·war

# Used by Next.js server-side fetches inside Docker network.
# In docker compose: http://backend:8000
# Without docker: same as NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://backend:8000
